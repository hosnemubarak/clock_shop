# -----------------------------------------------------------------------------
# cPanel / Shared Hosting Environment Configuration Example
# 
# Instructions:
# 1. Copy this file to `.env` on your cPanel server.
# 2. Update the values below with your real, secure production details.
# 3. NEVER commit your real `.env` file to version control.
# -----------------------------------------------------------------------------

# Django Settings
SECRET_KEY=replace-this-with-a-very-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# MySQL Database Settings (cPanel)
# Note: In cPanel, the database name and user usually have a prefix (e.g., username_dbname)
DB_ENGINE=mysql
DB_NAME=your_cpanel_db_name
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Application Settings
APP_PORT=80
ENABLE_RBAC=True
